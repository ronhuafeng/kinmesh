{
  "name": "kinmesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kinmesh-owned team identity and persistence foundation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server/main.ts",
    "start": "node --env-file=.env --import tsx src/server/main.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.ts",
    "architecture": "node --import tsx scripts/architecture.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run architecture",
    "onboard": "node --env-file=.env --import tsx scripts/onboard.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/secure-session": "^8.4.1",
    "@inquirer/prompts": "^8.7.5",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
