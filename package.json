{
  "name": "kinmesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kinmesh-owned team identity and persistence foundation",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx tests/run.ts tests/*.test.ts",
    "architecture": "depcruise src web tests scripts deploy --config .dependency-cruiser.json --output-type err && node --import tsx scripts/architecture.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run architecture",
    "link-human": "node --env-file=.env --import tsx scripts/link-human.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "t3:preflight": "node --import tsx scripts/t3-preflight.ts",
    "t3:auth": "node --env-file-if-exists=.env --import tsx scripts/t3-auth.ts",
    "t3:smoke": "node --env-file-if-exists=.env --import tsx scripts/t3-smoke.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/t3-live.ts",
    "build": "npm run typecheck && vite build && tsc --project tsconfig.build.json && node --import tsx scripts/stage-migrations.ts && node --import tsx scripts/stage-web.ts",
    "release:check": "npm run check && npm run format:check && npm run build && npm audit --omit=dev && npm run test:browser && node --env-file-if-exists=.env --import tsx scripts/release-live.ts",
    "test:contract": "node --import tsx tests/run.ts tests/t3-contract.test.ts tests/t3-recovery.test.ts tests/t3-auth.test.ts",
    "team:mcp": "node --env-file-if-exists=.env --import tsx src/team-mcp/main.ts",
    "team:smoke": "node --env-file-if-exists=.env --import tsx scripts/team-mcp-smoke.ts",
    "team:live:prepare": "node --env-file-if-exists=.env --import tsx scripts/team-live-prepare.ts",
    "test:team-mcp": "node --import tsx tests/run.ts tests/team-mcp.test.ts",
    "test:team-live": "node --env-file-if-exists=.env --import tsx scripts/team-t3-live.ts",
    "inbox:worker": "node --env-file-if-exists=.env --import tsx src/inbox/main.ts",
    "inbox:status": "node --env-file-if-exists=.env --import tsx src/inbox/main.ts status",
    "test:inbox-live": "node --env-file-if-exists=.env --import tsx scripts/inbox-t3-live.ts",
    "test:browser": "playwright test",
    "web:watch": "vite build --watch",
    "test:collaboration-live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.5",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@fastify/compress": "^9.3.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.12",
    "@inquirer/prompts": "^8.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "ajv": "8.20.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "hast-util-to-jsx-runtime": "2.3.7",
    "lowlight": "3.3.0",
    "lucide-react": "1.77.0",
    "mermaid": "12.3.0",
    "open": "^11.0.4",
    "postgres": "^4.1.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.4",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.3",
    "remark-gfm": "4.0.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^18.9.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    }
  }
}
