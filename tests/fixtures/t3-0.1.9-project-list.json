      "nextCursor": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["projects", "nextCursor"],
    "additionalProperties": true
  }
}
