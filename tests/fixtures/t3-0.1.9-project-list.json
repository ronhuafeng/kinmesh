{
  "name": "t3_project_list",
  "description": "List projects. Pages can shift.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "environmentId": {
        "type": "string"
      },
      "cursor": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "projects": {
        "type": "array",
