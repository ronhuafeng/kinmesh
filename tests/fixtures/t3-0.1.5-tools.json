    {
      "name": "t3_thread_send",
      "title": "Send to a T3 thread",
      "description": "Send a message to any thread. The target cannot run with broader modes than yours. `mode:'auto'` starts an idle thread, steers a running turn, or queues. `queue`: new turn. `steer`: mid-turn update. `restart`: interrupt and restart. A send to a finished child thread starts a fresh task and returns its `taskId`. In your reply, name it as its `link` verbatim.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "environmentId": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["auto", "queue", "steer", "restart"]
          },
          "clientRequestId": {
            "type": "string"
          }
        },
        "required": ["threadId", "message"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "messageId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "taskId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "preparing",
              "queued",
              "starting",
              "running",
              "waiting",
              "completed",
              "interrupted",
              "failed",
              "cancelled",
              "rolled_back"
            ]
          },
          "delivery": {
            "type": "string",
            "enum": ["started", "queued", "steered", "restarted"]
          }
        },
        "required": ["threadId", "messageId", "runId", "status", "delivery"],
        "additionalProperties": true
      },
      "annotations": {
        "title": "Send to a T3 thread",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "t3_thread_wait",
      "title": "Wait for a T3 thread",
      "description": "Wait for a thread's run to finish. No `runId`: latest. Idle: at once. On timeout, with `next` end your turn; without, call again.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "environmentId": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "number"
          },
          "untilDelegatedWorkSettled": {
            "type": "boolean",
            "description": "Also wait for its delegated and background tasks and their completions to settle. `resultRun` then names the run with its final answer."
          }
        },
        "required": ["threadId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "preparing",
              "queued",
              "starting",
              "running",
              "waiting",
              "completed",
              "interrupted",
              "failed",
              "cancelled",
              "rolled_back"
            ]
          },
          "timedOut": {
            "type": "boolean"
          },
          "next": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Completion wakes this thread, so end your turn. Do not wait on it or poll it."
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "resultRun": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
