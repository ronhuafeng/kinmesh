                      "queued",
                      "starting",
                      "running",
                      "waiting",
                      "completed",
                      "interrupted",
                      "failed",
                      "cancelled",
                      "rolled_back"
                    ]
                  }
                },
                "required": ["runId", "status"],
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["threadId", "runId", "status", "timedOut"],
        "additionalProperties": true
      },
      "annotations": {
        "title": "Wait for a T3 thread",
        "readOnlyHint": true,
        "destructiveHint": false,
