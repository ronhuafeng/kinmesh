    {
      "name": "t3_thread_interrupt",
      "title": "Interrupt a T3 thread",
      "description": "Interrupt a top-level thread's running turn. No `runId`: newest running turn. No effect when idle. For a delegate, use `task_cancel`.",
      "inputSchema": {
        "type": "object",
