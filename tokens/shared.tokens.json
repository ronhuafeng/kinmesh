  "control": {
    "touch": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "row": {
      "$type": "dimension",
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
