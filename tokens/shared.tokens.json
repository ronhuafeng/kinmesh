{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "SF Pro Text",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Maple Mono",
        "ui-monospace",
        "SF Mono",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "monospace"
      ]
    },
    "code": {
      "$description": "A block of code, which keeps columns: its Chinese is two columns wide.",
      "$type": "fontFamily",
      "$value": [
        "Maple Mono",
        "Code Han",
        "ui-monospace",
        "SF Mono",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "monospace"
      ]
    }
  },
  "text": {
    "body": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "body-phone": {
      "$type": "dimension",
      "$value": {
        "value": 17,
        "unit": "px"
      }
    },
    "ui": {
      "$type": "dimension",
      "$value": {
        "value": 0.9375,
        "unit": "rem"
      }
    },
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 13,
        "unit": "px"
      }
    },
    "code": {
      "$type": "dimension",
      "$value": {
        "value": 0.85,
        "unit": "em"
      }
    }
  },
  "typography": {
    "large-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 34,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{text.body}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body-phone": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{text.body-phone}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "ui": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{text.ui}",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{text.ui}",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{text.small}",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.code}",
        "fontSize": {
          "value": 13.6,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    }
