      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": [0.2, 0.8, 0.2, 1]
    },
    "spring": {
      "$type": "cubicBezier",
      "$value": [0.34, 1.3, 0.64, 1]
    }
  }
