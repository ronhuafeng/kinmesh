# Run npm run setup to generate private random credentials in .env.
KINMESH_SETUP_TOKEN=GENERATE_WITH_SETUP_COMMAND
KINMESH_SESSION_KEY=GENERATE_WITH_SETUP_COMMAND
KINMESH_DATABASE=.store/kinmesh.sqlite
KINMESH_ORIGIN=http://127.0.0.1:3000
KINMESH_PORT=3000

# Optional external T3 adapter: paths only, NEVER put bearer tokens here.
KINMESH_T3_ENDPOINT=https://your-owner-private-origin.example/mcp
KINMESH_T3_AUTH_FILE=.store/t3-owner-oauth.json
KINMESH_T3_READ_AUTH_FILE=.store/t3-read-oauth.json
KINMESH_T3_PROVIDER=codex
KINMESH_T3_MODEL=your-advertised-model-id
# Explicit paid disposable acceptance opt-in; two model turns per gate invocation.
KINMESH_T3_LIVE=0
KINMESH_T3_LIVE_DATABASE=.store/t3-live.sqlite
KINMESH_T3_LIVE_REPORT=.store/t3-live-report.json

# Standalone agent-only Team MCP; keep bearer values in private token files.
KINMESH_TEAM_MCP_PORT=3001
KINMESH_TEAM_MCP_ORIGIN=http://127.0.0.1:3001
KINMESH_TEAM_MCP_CONCURRENCY=16
KINMESH_TEAM_MCP_ENDPOINT=http://127.0.0.1:3001/mcp
KINMESH_TEAM_MCP_TOKEN_FILE=.store/team-agent.json
# Optional paid/provider gate, separate from credential-free SDK integration.
KINMESH_TEAM_T3_LIVE=0
# Prepare a NEW private disposable directory before enabling this gate.
# KINMESH_TEAM_LIVE_DIR=/tmp/kinmesh-team-live-owner
# KINMESH_TEAM_T3_ISOLATED_PROVIDER=owner-configured-isolated-provider-instance

# Optional normal-start Inbox supervision; private config must use KINMESH_DATABASE.
# Omit this variable when deploying inbox:worker independently.
# KINMESH_INBOX_CONFIG=/private/kinmesh/inbox.json
